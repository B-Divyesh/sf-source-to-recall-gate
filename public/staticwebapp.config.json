{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.sociobot.in; manifest-src 'self'; worker-src 'self'",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "routes": [
    {
      "route": "/demo",
      "redirect": "/demo/",
      "statusCode": 301
    },
    {
      "route": "/privacy",
      "redirect": "/privacy/",
      "statusCode": 301
    },
    {
      "route": "/terms",
      "redirect": "/terms/",
      "statusCode": 301
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/downloads/source-to-recall-gate-chrome.zip",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Disposition": "attachment; filename=source-to-recall-gate-chrome.zip",
        "Content-Type": "application/zip"
      }
    },
    {
      "route": "/downloads/*",
      "statusCode": 404
    }
  ]
}
