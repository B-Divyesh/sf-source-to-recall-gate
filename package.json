{
  "name": "source-to-recall-gate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:extension": "wxt",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:extension": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run --root . src",
    "test:watch": "vitest --root . src",
    "test:e2e": "playwright test",
    "test:extension": "npm run build:extension && node scripts/smoke-extension.mjs",
    "test:site-package": "npm run build:site && node scripts/verify-site-package.mjs",
    "test:live-download": "node scripts/verify-live-download.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.7",
    "@types/chrome": "^0.0.302",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.8",
    "wxt": "^0.20.6"
  }
}
