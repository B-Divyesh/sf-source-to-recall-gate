{
  "name": "source-to-recall-gate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:extension": "wxt",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:extension": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run --root . src",
    "test:claims": "node scripts/test-claims.mjs",
    "test:watch": "vitest --root . src",
    "test:e2e": "playwright test",
    "test:extension": "npm run build:extension && node scripts/smoke-extension.mjs",
    "test:site-package": "npm run build:site && node scripts/verify-site-package.mjs",
    "test:live-download": "node scripts/verify-live-download.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  }
}
